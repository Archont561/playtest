{
	"name": "@archont561/playtest",
	"version": "0.1.0",
	"description": "Playwright-style testing framework for TypeScript with dependency-injected fixtures, strict LIFO teardown, property-based testing, and code-first BDD",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "bunup",
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"keywords": [
		"testing",
		"fixtures",
		"playwright",
		"bdd",
		"pbt"
	],
	"author": "Archont561",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Archont561/playtest.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@types/bun": "^1.4.4",
		"bunup": "^0.16.32",
		"typescript": "^6.0.3"
	}
}
