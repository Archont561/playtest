{
	"name": "@archont561/playtest",
	"version": "0.1.0",
	"description": "Polyglot test framework with the batteries included: dependency-injected fixtures, strict LIFO teardown, property-based testing, and code-first BDD for TypeScript",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./adapters/bun": {
			"types": "./dist/adapters/bun.d.ts",
			"import": "./dist/adapters/bun.js",
			"default": "./dist/adapters/bun.js"
		},
		"./adapters/vitest": {
			"types": "./dist/adapters/vitest.d.ts",
			"import": "./dist/adapters/vitest.js",
			"default": "./dist/adapters/vitest.js"
		},
		"./adapters/jest": {
			"types": "./dist/adapters/jest.d.ts",
			"import": "./dist/adapters/jest.js",
			"default": "./dist/adapters/jest.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "bunup",
		"typecheck": "tsc --noEmit",
		"test": "bun test tests",
		"test:runners": "vitest run --config vitest.config.mts && jest --config jest.config.mts"
	},
	"keywords": [
		"testing",
		"fixtures",
		"playwright",
		"bdd",
		"pbt"
	],
	"author": "Archont561",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Archont561/playtest.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@swc/jest": "^0.2.39",
		"@types/bun": "^1.4.4",
		"@types/jest": "^30.0.0",
		"bunup": "^0.16.32",
		"jest": "^30.5.2",
		"typescript": "^6.0.3",
		"vitest": "^5.1.0"
	}
}
